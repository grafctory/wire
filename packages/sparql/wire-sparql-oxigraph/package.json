{
  "name": "@grafctory/wire-sparql-oxigraph",
  "version": "0.13.1",
  "description": "SPARQL connector for @grafctory/wire backed by an Oxigraph in-memory WASM store.",
  "keywords": [
    "typescript",
    "json-ld",
    "model-driven",
    "sparql",
    "oxigraph"
  ],
  "homepage": "https://grafctory.github.io/wire/",
  "bugs": {
    "url": "https://github.com/grafctory/wire/issues",
    "email": "info@grafctory.dev"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grafctory/wire.git",
    "directory": "packages/wire-sparql-oxigraph"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@grafctory/source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "ush rm dist docs node_modules",
    "build": "ush rm dist && tsc -p tsconfig.build.json",
    "check": "npx vitest --typecheck run"
  },
  "dependencies": {
    "@grafctory/core": "^0.14.0",
    "@grafctory/trio": "^0.3.0",
    "@grafctory/wire-sparql": "^0.13.1"
  },
  "peerDependencies": {
    "oxigraph": ">=0.5.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.0.13"
  }
}
