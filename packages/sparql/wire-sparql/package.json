{
  "name": "@grafctory/wire-sparql",
  "version": "0.13.1",
  "description": "SPARQL 1.1 query language framework for @grafctory/wire storage connectors.",
  "keywords": [
    "typescript",
    "rdf",
    "iri",
    "sparql"
  ],
  "homepage": "https://grafctory.github.io/wire/",
  "bugs": {
    "url": "https://github.com/grafctory/wire/issues",
    "email": "info@grafctory.dev"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grafctory/wire.git",
    "directory": "packages/wire-sparql"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@grafctory/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./builder": {
      "@grafctory/source": "./src/builder.ts",
      "default": "./dist/builder.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "ush rm dist docs node_modules",
    "build": "ush rm dist && tsc -p tsconfig.build.json",
    "check": "npx vitest --typecheck run"
  },
  "dependencies": {
    "@grafctory/core": "^0.14.0",
    "@grafctory/trio": "^0.3.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.0.13"
  },
  "peerDependencies": null
}
